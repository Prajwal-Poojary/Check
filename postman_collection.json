        {
            "name": "Report",
            "item": [
                {
                    "name": "Get Monthly Report",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/report?month=2025-12",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "report"
                            ],
                            "query": [
                                {
                                    "key": "month",
                                    "value": "2025-12"
                                }
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        }
    ]
}