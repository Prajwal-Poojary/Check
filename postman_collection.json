                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"category\": \"Food\",\n    \"amount\": 5000,\n    \"month\": \"2025-12\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/budgets",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "budgets"
                            ]
                        }
                    },
                    "response": []
